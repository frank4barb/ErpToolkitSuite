@model HealthDemo.Models.SIO.Common.Richiesta
@{
    ViewData["Title"] = "Richiesta Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "Richiesta", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Ri1Icode", Model?.Ri1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="RiIdUnitaRichiedente" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiIdUnitaRichiedenteObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiIdPostazioneRichiedente" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiIdPostazioneRichiedenteObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiIdIstitutoRichiedente" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiIdIstitutoRichiedenteObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiIdOperatoreRichiedente" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiIdOperatoreRichiedenteObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiDataRichiesta" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiDataRichiesta)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiOraRichiesta" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiOraRichiesta)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiUrgenza" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiUrgenza)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiOggetto" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiOggetto)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiStatoRichiesta" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiStatoRichiesta)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiIdTipoRichiesta" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiIdTipoRichiestaObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiIdPaziente" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiIdPazienteObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="RiIdEpisodio" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.RiIdEpisodioObj?.ToHtml() ?? "")</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
