@model HealthDemo.Models.SIO.Common.Organizzazione
@{
    ViewData["Title"] = "Organizzazione Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "Organizzazione", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Or1Icode", Model?.Or1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="OrClasseAssistenza" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrClasseAssistenza)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrCodice" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrCodice)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrDescrizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrDescrizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrNote" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrNote)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrEmail" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrEmail)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrTipoAssistenza" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrTipoAssistenzaObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrTelefono" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrTelefono)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrIdPersonale" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrIdPersonaleObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrIdIstituto" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrIdIstitutoObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrIdUnita" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrIdUnitaObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrIdPostazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrIdPostazioneObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrPwdCrypt" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrPwdCrypt)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrAttivo" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrAttivo)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="OrIdentificativo" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.OrIdentificativo)</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
