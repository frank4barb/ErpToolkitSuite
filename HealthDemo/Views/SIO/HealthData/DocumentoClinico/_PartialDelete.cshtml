@model HealthDemo.Models.SIO.HealthData.DocumentoClinico
@{
    ViewData["Title"] = "DocumentoClinico Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "DocumentoClinico", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Dc1Icode", Model?.Dc1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="DcClasse" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcClasse)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcIdPaziente" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcIdPazienteObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcIdEpisodio" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcIdEpisodioObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcIdTipoDatoClinico" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcIdTipoDatoClinicoObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcValoreMinimo" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcValoreMinimo)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcValoreMassimo" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcValoreMassimo)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcValoreScelta" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcValoreScelta)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcValoreTesto" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcValoreTesto)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcNote" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcNote)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcCodiceReferto" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcCodiceReferto)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcDataAcquisizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcDataAcquisizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcOraAcquisizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcOraAcquisizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcStatoDatoClinico" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcStatoDatoClinico)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcDataValidazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcDataValidazione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcOraValidazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcOraValidazione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="DcSequenza" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.DcSequenza)</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
