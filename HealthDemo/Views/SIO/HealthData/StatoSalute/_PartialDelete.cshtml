@model HealthDemo.Models.SIO.HealthData.StatoSalute
@{
    ViewData["Title"] = "StatoSalute Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "StatoSalute", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Ss1Icode", Model?.Ss1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="SsClasse" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsClasse)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsIdPaziente" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsIdPazienteObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsIdEpisodio" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsIdEpisodioObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsIdTipoDatoClinico" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsIdTipoDatoClinicoObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsValoreMinimo" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsValoreMinimo)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsValoreMassimo" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsValoreMassimo)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsValoreScelta" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsValoreScelta)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsValoreTesto" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsValoreTesto)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsNote" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsNote)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsCodiceReferto" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsCodiceReferto)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsDataAcquisizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsDataAcquisizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsOraAcquisizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsOraAcquisizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsStatoDatoClinico" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsStatoDatoClinico)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsDataValidazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsDataValidazione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsOraValidazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsOraValidazione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SsSequenza" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SsSequenza)</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
