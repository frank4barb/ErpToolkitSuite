@model HealthDemo.Models.SIO.HealthData.ParametroVitale
@{
    ViewData["Title"] = "ParametroVitale Edit [" + (Model?.action ?? ' ') + "]";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Save", "ParametroVitale", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Pv1Icode", Model?.Pv1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        <label asp-for="PvClasse" class="control-label"></label>
                        <input asp-for="PvClasse" class="form-control" />
                        <span asp-validation-for="PvClasse" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvIdPaziente" class="control-label"></label>
                        <input asp-for="PvIdPaziente" class="form-control"  data-mandatory="true" />
                        <span asp-validation-for="PvIdPaziente" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvIdEpisodio" class="control-label"></label>
                        <input asp-for="PvIdEpisodio" class="form-control" />
                        <span asp-validation-for="PvIdEpisodio" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvIdTipoDatoClinico" class="control-label"></label>
                        <input asp-for="PvIdTipoDatoClinico" class="form-control"  data-mandatory="true" />
                        <span asp-validation-for="PvIdTipoDatoClinico" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvValoreMinimo" class="control-label"></label>
                        <input asp-for="PvValoreMinimo" class="form-control" />
                        <span asp-validation-for="PvValoreMinimo" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvValoreMassimo" class="control-label"></label>
                        <input asp-for="PvValoreMassimo" class="form-control" />
                        <span asp-validation-for="PvValoreMassimo" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvValoreScelta" class="control-label"></label>
                        <input asp-for="PvValoreScelta" class="form-control" />
                        <span asp-validation-for="PvValoreScelta" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvValoreTesto" class="control-label"></label>
                        <input asp-for="PvValoreTesto" class="form-control" />
                        <span asp-validation-for="PvValoreTesto" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvNote" class="control-label"></label>
                        <input asp-for="PvNote" class="form-control" />
                        <span asp-validation-for="PvNote" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvCodiceReferto" class="control-label"></label>
                        <input asp-for="PvCodiceReferto" class="form-control" />
                        <span asp-validation-for="PvCodiceReferto" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvDataAcquisizione" class="control-label"></label>
                        <input asp-for="PvDataAcquisizione" class="form-control" />
                        <span asp-validation-for="PvDataAcquisizione" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvOraAcquisizione" class="control-label"></label>
                        <input asp-for="PvOraAcquisizione" class="form-control" />
                        <span asp-validation-for="PvOraAcquisizione" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvStatoDatoClinico" class="control-label"></label>
                        <input asp-for="PvStatoDatoClinico" class="form-control" />
                        <span asp-validation-for="PvStatoDatoClinico" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvDataValidazione" class="control-label"></label>
                        <input asp-for="PvDataValidazione" class="form-control" />
                        <span asp-validation-for="PvDataValidazione" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvOraValidazione" class="control-label"></label>
                        <input asp-for="PvOraValidazione" class="form-control" />
                        <span asp-validation-for="PvOraValidazione" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvSequenza" class="control-label"></label>
                        <input asp-for="PvSequenza" class="form-control" />
                        <span asp-validation-for="PvSequenza" class="text-danger"></span>
                    </div>
                    @* =============== TABELLA XREF =============== *@
                    @if (Model?.XrefPdIdDatoClinico != null)
                    {
                        <h5 class="mt-5">Vista su RelPrestazioneDatoClinico per PdIdDatoClinico</h5>
                        <erp-table asp-for="XrefPdIdDatoClinico" allow-add="true" allow-edit="true" allow-delete="true" allow-undelete="true" maxLine="10" editFilter="true">
                            <erp-table-columns>
                                <erp-table-col for="PdClasseDatoClinico"     label="ClasseDatoClinico" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="PdIdPrestazione"     label="IdPrestazione" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="PdTipoRelazione"     label="TipoRelazione" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="PdNote"     label="Note" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="PdIdDatoClinico"  visible="false"   value="@Model.Pv1Icode" />
                            </erp-table-columns>
                            <erp-table-edit-columns>
                                <erp-table-edit-col for="PdClasseDatoClinico">
                                    <div class="form-group" data-prop="PdClasseDatoClinico">
                                        <input asp-for='XrefPdIdDatoClinico["0"].PdClasseDatoClinico' class="form-control" data-mandatory="true" />
                                        <span asp-validation-for='XrefPdIdDatoClinico["0"].PdClasseDatoClinico' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                                <erp-table-edit-col for="PdIdPrestazione">
                                    <div class="form-group" data-prop="PdIdPrestazione">
                                        <input asp-for='XrefPdIdDatoClinico["0"].PdIdPrestazione' class="form-control" />
                                        <span asp-validation-for='XrefPdIdDatoClinico["0"].PdIdPrestazione' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                                <erp-table-edit-col for="PdTipoRelazione">
                                    <div class="form-group" data-prop="PdTipoRelazione">
                                        <input asp-for='XrefPdIdDatoClinico["0"].PdTipoRelazione' class="form-control" />
                                        <span asp-validation-for='XrefPdIdDatoClinico["0"].PdTipoRelazione' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                                <erp-table-edit-col for="PdNote">
                                    <div class="form-group" data-prop="PdNote">
                                        <input asp-for='XrefPdIdDatoClinico["0"].PdNote' class="form-control" />
                                        <span asp-validation-for='XrefPdIdDatoClinico["0"].PdNote' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                            </erp-table-edit-columns>
                            <erp-table-actions mode="all" />
                        </erp-table>
                    }

                    @* =============== TABELLA XDATA =============== *@
                    @if (Model?.Xdata != null && Model.Xdata.Any())
                    {
                        <br />
                        <erp-document-container
                            asp-for="Xdata"
                            record-icode="@Model.Pv1Icode"
                            controller-name="ParametroVitale"
                            allow-add="true"
                            allow-update="true"
                            allow-delete="true"
                            add-url="@Url.Action("AddXdata", "ParametroVitale")"
                            update-url="@Url.Action("UpdateXdata", "ParametroVitale")"
                            delete-url="@Url.Action("DeleteXdata", "ParametroVitale")"
                            type-source-url="@Url.Action("XdataTypes", "ParametroVitale")"
                            height="500">
                        </erp-document-container>
@*                        @foreach (var kvp in Model.Xdata)
                        {
                            var x = kvp.Value;
                            <h6>@x.Descr</h6>
                            <div class="mb-3"><erp-document-viewer controller-name="ParametroVitale" blob-id="@x.Icode" content-type="@x._mime" height="500"></erp-document-viewer></div>
                        }
*@
                    }
                 
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "EditModale")'>Salva</button>
            </div>
        </div>
    }
</div>
