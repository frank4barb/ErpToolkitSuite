@model HealthDemo.Models.SIO.HealthData.ParametroVitale
@{
    ViewData["Title"] = "ParametroVitale Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "ParametroVitale", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Pv1Icode", Model?.Pv1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="PvClasse" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvClasse)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvIdPaziente" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvIdPazienteObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvIdEpisodio" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvIdEpisodioObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvIdTipoDatoClinico" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvIdTipoDatoClinicoObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvValoreMinimo" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvValoreMinimo)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvValoreMassimo" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvValoreMassimo)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvValoreScelta" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvValoreScelta)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvValoreTesto" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvValoreTesto)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvNote" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvNote)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvCodiceReferto" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvCodiceReferto)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvDataAcquisizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvDataAcquisizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvOraAcquisizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvOraAcquisizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvStatoDatoClinico" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvStatoDatoClinico)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvDataValidazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvDataValidazione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvOraValidazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvOraValidazione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="PvSequenza" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.PvSequenza)</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
