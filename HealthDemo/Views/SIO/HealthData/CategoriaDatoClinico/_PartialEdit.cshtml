@model HealthDemo.Models.SIO.HealthData.CategoriaDatoClinico
@{
    ViewData["Title"] = "CategoriaDatoClinico Edit [" + (Model?.action ?? ' ') + "]";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
