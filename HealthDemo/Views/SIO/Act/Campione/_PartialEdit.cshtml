@model HealthDemo.Models.SIO.Act.Campione
@{
    ViewData["Title"] = "Campione Edit [" + (Model?.action ?? ' ') + "]";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Save", "Campione", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Cp1Icode", Model?.Cp1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    <div class="form-group">
                        <label asp-for="CpIdTipoCampione" class="control-label"></label>
                        <input asp-for="CpIdTipoCampione" class="form-control"  data-mandatory="true" />
                        <span asp-validation-for="CpIdTipoCampione" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpDescrizione" class="control-label"></label>
                        <input asp-for="CpDescrizione" class="form-control" />
                        <span asp-validation-for="CpDescrizione" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpCodiceUnivoco" class="control-label"></label>
                        <input asp-for="CpCodiceUnivoco" class="form-control" />
                        <span asp-validation-for="CpCodiceUnivoco" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpDataPrelievo" class="control-label"></label>
                        <input asp-for="CpDataPrelievo" class="form-control" />
                        <span asp-validation-for="CpDataPrelievo" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpOraPrelievo" class="control-label"></label>
                        <input asp-for="CpOraPrelievo" class="form-control" />
                        <span asp-validation-for="CpOraPrelievo" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpNote" class="control-label"></label>
                        <input asp-for="CpNote" class="form-control" />
                        <span asp-validation-for="CpNote" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpIdEpisodio" class="control-label"></label>
                        <input asp-for="CpIdEpisodio" class="form-control"  data-mandatory="true" />
                        <span asp-validation-for="CpIdEpisodio" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpIdPaziente" class="control-label"></label>
                        <input asp-for="CpIdPaziente" class="form-control" />
                        <span asp-validation-for="CpIdPaziente" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpCodiceAssoluto" class="control-label"></label>
                        <input asp-for="CpCodiceAssoluto" class="form-control" />
                        <span asp-validation-for="CpCodiceAssoluto" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpStatoCampione" class="control-label"></label>
                        <input asp-for="CpStatoCampione" class="form-control" />
                        <span asp-validation-for="CpStatoCampione" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpIdPosizioneAttuale" class="control-label"></label>
                        <input asp-for="CpIdPosizioneAttuale" class="form-control" />
                        <span asp-validation-for="CpIdPosizioneAttuale" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpDescPosizioneAttuale" class="control-label"></label>
                        <input asp-for="CpDescPosizioneAttuale" class="form-control" />
                        <span asp-validation-for="CpDescPosizioneAttuale" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpDataCambiamentoStato" class="control-label"></label>
                        <input asp-for="CpDataCambiamentoStato" class="form-control" />
                        <span asp-validation-for="CpDataCambiamentoStato" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpOraCambiamentoStato" class="control-label"></label>
                        <input asp-for="CpOraCambiamentoStato" class="form-control" />
                        <span asp-validation-for="CpOraCambiamentoStato" class="text-danger"></span>
                    </div>
                    <div class="form-group">
                        <label asp-for="CpNoteCambiamentoStato" class="control-label"></label>
                        <input asp-for="CpNoteCambiamentoStato" class="form-control" />
                        <span asp-validation-for="CpNoteCambiamentoStato" class="text-danger"></span>
                    </div>
                    @* =============== TABELLA XREF =============== *@
                    @if (Model?.XrefPcIdCampione != null)
                    {
                        <h5 class="mt-5">Vista su RelPrestazioneCampione per PcIdCampione</h5>
                        <erp-table asp-for="XrefPcIdCampione" allow-add="true" allow-edit="true" allow-delete="true" allow-undelete="true" maxLine="10" editFilter="true">
                            <erp-table-columns>
                                <erp-table-col for="PcIdPrestazione"     label="IdPrestazione" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="PcTipo"     label="Tipo" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="PcNote"     label="Note" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="PcIdTipoCampione"     label="IdTipoCampione" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="PcIdCampione"  visible="false"   value="@Model.Cp1Icode" />
                            </erp-table-columns>
                            <erp-table-edit-columns>
                                <erp-table-edit-col for="PcIdPrestazione">
                                    <div class="form-group" data-prop="PcIdPrestazione">
                                        <input asp-for='XrefPcIdCampione["0"].PcIdPrestazione' class="form-control" data-mandatory="true" />
                                        <span asp-validation-for='XrefPcIdCampione["0"].PcIdPrestazione' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                                <erp-table-edit-col for="PcTipo">
                                    <div class="form-group" data-prop="PcTipo">
                                        <input asp-for='XrefPcIdCampione["0"].PcTipo' class="form-control" />
                                        <span asp-validation-for='XrefPcIdCampione["0"].PcTipo' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                                <erp-table-edit-col for="PcNote">
                                    <div class="form-group" data-prop="PcNote">
                                        <input asp-for='XrefPcIdCampione["0"].PcNote' class="form-control" />
                                        <span asp-validation-for='XrefPcIdCampione["0"].PcNote' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                                <erp-table-edit-col for="PcIdTipoCampione">
                                    <div class="form-group" data-prop="PcIdTipoCampione">
                                        <input asp-for='XrefPcIdCampione["0"].PcIdTipoCampione' class="form-control" />
                                        <span asp-validation-for='XrefPcIdCampione["0"].PcIdTipoCampione' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                            </erp-table-edit-columns>
                            <erp-table-actions mode="all" />
                        </erp-table>
                    }

                    @* =============== TABELLA XDATA =============== *@
                    @if (Model?.Xdata != null && Model.Xdata.Any())
                    {
                        <br />
                        @foreach (var kvp in Model.Xdata)
                        {
                            var x = kvp.Value;
                            <h6>@x.Descr</h6>
                            <div class="mb-3"><erp-document-viewer controller-name="Campione" blob-id="@x.Icode" content-type="@x._mime" height="500"></erp-document-viewer></div>
                        }
                    }
                
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "EditModale")'>Salva</button>
            </div>
        </div>
    }
</div>
