@model HealthDemo.Models.SIO.Resource.Materiale
@{
    ViewData["Title"] = "Materiale Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "Materiale", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Mt1Icode", Model?.Mt1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="MtCodice" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtCodice)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtDescrizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtDescrizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtIdTipoRisorsa" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtIdTipoRisorsaObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtCostoUnitarioUso" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtCostoUnitarioUso)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtMisuraUnitariaUso" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtMisuraUnitariaUso)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtNote" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtNote)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtDisponibilita" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtDisponibilita)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtTelefonoFornitore" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtTelefonoFornitore)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtQuantitaDisponibile" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtQuantitaDisponibile)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtQuantitaMinimaMagazzino" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtQuantitaMinimaMagazzino)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtUsoMedioGiornaliero" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtUsoMedioGiornaliero)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtDataUltimoOrdine" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtDataUltimoOrdine)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtQuantitaUltimoOrdine" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtQuantitaUltimoOrdine)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtDataProssimoOrdine" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtDataProssimoOrdine)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtQuantitaMediaOrdine" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtQuantitaMediaOrdine)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="MtCodiceNazionale" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.MtCodiceNazionale)</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
