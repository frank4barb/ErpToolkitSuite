@model HealthDemo.Models.SIO.Resource.Farmaco
@{
    ViewData["Title"] = "Farmaco Edit [" + (Model?.action ?? ' ') + "]";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
