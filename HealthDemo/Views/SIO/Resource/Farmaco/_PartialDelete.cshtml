@model HealthDemo.Models.SIO.Resource.Farmaco
@{
    ViewData["Title"] = "Farmaco Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "Farmaco", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Fm1Icode", Model?.Fm1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="FmCodice" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmCodice)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmDescrizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmDescrizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmIdTipoRisorsa" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmIdTipoRisorsaObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmCostoUnitarioUso" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmCostoUnitarioUso)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmMisuraUnitariaUso" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmMisuraUnitariaUso)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmNote" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmNote)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmDisponibilita" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmDisponibilita)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmQuantitaDisponibile" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmQuantitaDisponibile)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmQuantitaMinimaMagazzino" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmQuantitaMinimaMagazzino)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmUsoMedioGiornaliero" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmUsoMedioGiornaliero)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmDataUltimoOrdine" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmDataUltimoOrdine)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmQuantitaUltimoOrdine" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmQuantitaUltimoOrdine)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmDataProssimoOrdine" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmDataProssimoOrdine)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmQuantitaMediaOrdine" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmQuantitaMediaOrdine)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmRiferimentiFornitore" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmRiferimentiFornitore)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmCodiceNazionale" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmCodiceNazionale)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmCodiceAic" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmCodiceAic)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmDataInizioAutorizzazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmDataInizioAutorizzazione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="FmDataFineAutorizzazione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.FmDataFineAutorizzazione)</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
