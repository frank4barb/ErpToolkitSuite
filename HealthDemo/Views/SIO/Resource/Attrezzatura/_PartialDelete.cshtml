@model HealthDemo.Models.SIO.Resource.Attrezzatura
@{
    ViewData["Title"] = "Attrezzatura Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "Attrezzatura", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"At1Icode", Model?.At1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="AtCodice" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtCodice)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtDescrizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtDescrizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtIdTipoRisorsa" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtIdTipoRisorsaObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtCostoUnitarioUso" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtCostoUnitarioUso)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtMisuraUnitariaUso" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtMisuraUnitariaUso)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtNote" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtNote)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtDisponibilita" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtDisponibilita)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtTelefonoFornitore" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtTelefonoFornitore)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtNumeroSeriale" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtNumeroSeriale)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtRiferimentiAssistenza" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtRiferimentiAssistenza)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtTelefonoAssistenza" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtTelefonoAssistenza)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtDataUltimaManutenzione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtDataUltimaManutenzione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtFrequenzaManutenzione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtFrequenzaManutenzione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtUsoMedioGiornaliero" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtUsoMedioGiornaliero)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="AtDataProssimaManutenzione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.AtDataProssimaManutenzione)</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
