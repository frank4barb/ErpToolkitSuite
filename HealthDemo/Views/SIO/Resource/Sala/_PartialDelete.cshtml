@model HealthDemo.Models.SIO.Resource.Sala
@{
    ViewData["Title"] = "Sala Delete [" + (Model?.action ?? ' ') + "]";
    ViewData["TagHelper__READONLY_PAGE"] = "Y";
}
<div class="modal-dialog modal-xl modal-dialog-scrollable" role="document">
    @using (Html.BeginForm("Delete", "Sala", FormMethod.Post)) { @if (Model != null)
    {
        @Html.AntiForgeryToken()
        <!--GESTISCE AZIONI CLICK PULSANTE-->
        @Html.Hidden("IsModalACTION", @ViewData["IsModalACTION"])
        @Html.Hidden("IsPageACTION", @ViewData["IsPageACTION"])
        @Html.Hidden("IsPageREDIRECT", @ViewData["IsPageREDIRECT"])
        @Html.TextBox($"action", Model?.action, new { type = "hidden", @class = "ModelAction" })
        @Html.TextBox($"vars", @ErpToolkit.Helpers.Db.DogManager.JsonSafeSerializeToBase64Url(Model?.vars), new { type = "hidden", @class = "ModelVars" })
        @Html.TextBox($"Sa1Icode", Model?.Sa1Icode, new { type = "hidden", @class = "ModelIcode" })
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="titolo">@ViewData["Title"]</h5>
                <button type="button" class="close" data-bs-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <div class="container">
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    Sei proprio sicuro di voler cancellare il seguente record?<br><p>.</p>
                    <div class="form-group">
                        <label asp-for="SaCodice" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaCodice)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaIdTipoRisorsa" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaIdTipoRisorsaObj?.ToHtml() ?? "")</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaDescrizione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaDescrizione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaCostoUnitarioUso" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaCostoUnitarioUso)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaMisuraUnitariaUso" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaMisuraUnitariaUso)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaNote" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaNote)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaDisponibilita" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaDisponibilita)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaTelefonoFornitore" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaTelefonoFornitore)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaDataUltimaManutenzione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaDataUltimaManutenzione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaFrequenzaManutenzione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaFrequenzaManutenzione)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaUsoMedioGiornaliero" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaUsoMedioGiornaliero)</span>
                    </div>
                    <div class="form-group">
                        <label asp-for="SaDataProssimaManutenzione" class="control-label"></label>:  
                        <span>@Html.Raw(@Model.SaDataProssimaManutenzione)</span>
                    </div>
                </div>
                <br />
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annulla</button>
                <button type="button" class="btn btn-primary" onclick='etkValidateAndSubmitModal(this, "@ViewData.TemplateInfo.HtmlFieldPrefix", "DeleteModale")'>Elimina</button>
            </div>
        </div>
    } }
</div>
