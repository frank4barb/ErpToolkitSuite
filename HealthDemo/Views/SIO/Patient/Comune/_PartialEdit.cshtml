                                <erp-table-col for="DiNote"     label="Note" sort="none" sortType="autocomplete" filter="true" />
                                <erp-table-col for="DiIdComune"  visible="false"   value="@Model.Cm1Icode" />
                            </erp-table-columns>
                            <erp-table-edit-columns>
                                <erp-table-edit-col for="DiCodice">
                                    <div class="form-group" data-prop="DiCodice">
                                        <input asp-for='XrefDiIdComune["0"].DiCodice' class="form-control" />
                                        <span asp-validation-for='XrefDiIdComune["0"].DiCodice' class="text-danger"></span>
                                    </div>
                                </erp-table-edit-col>
                                <erp-table-edit-col for="DiNome">
